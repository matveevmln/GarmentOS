# Конфигурация окружения GarmentOS — 12-factor: все параметры через переменные
# окружения, ничего провайдеро-специфичного не хардкодится (см. docs/INFRASTRUCTURE.md).
# Скопируйте в .env и заполните реальными значениями для локальной разработки.

NODE_ENV=development
PORT=3000

# PostgreSQL — стандартный протокол, работает с любым self-hosted/managed Postgres
DATABASE_URL=postgres://garmentos:garmentos@localhost:5432/garmentos

# Redis — стандартный протокол (кэш + очереди BullMQ)
REDIS_URL=redis://localhost:6379

# S3-совместимое объектное хранилище — доступ только через StorageAdapter
# (docs/INFRASTRUCTURE.md, п.2.3). Значения ниже — для локального MinIO из
# infra/docker-compose.yml; на проде меняются на реквизиты выбранного провайдера
# без изменений в коде.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=garmentos-local
S3_ACCESS_KEY=garmentos
S3_SECRET_KEY=garmentos-local-secret
S3_FORCE_PATH_STYLE=true

# JWT (Identity & Access, Фаза 1 итерация 5) — сгенерировать реальный секрет перед первым запуском
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# CORS — список разрешённых источников через запятую (apps/api/src/main.ts).
# Не задано = разрешено всё (только для локальной разработки); на проде
# обязательно указать точный публичный домен apps/web.
CORS_ORIGIN=http://localhost:5173

# Anthropic API — используется только AIClassifier (разбор текстового
# производственного запроса, docs/AI_PRODUCTION_ASSISTANT_ARCHITECTURE.md).
# Не задано = детерминированный rule-based fallback вместо реального LLM
# (RuleBasedAIClassifier) — рабочий, но упрощённый разбор.
ANTHROPIC_API_KEY=
